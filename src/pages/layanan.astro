---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { siteConfig } from '../data/siteConfig';

// Generate Schema.org Service items
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Service',
      name: service.name,
      description: service.shortDescription,
      provider: {
        '@type': 'LocalBusiness',
        name: siteConfig.name,
        url: siteConfig.siteUrl,
      },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'IDR',
        eligibleQuantity: {
          '@type': 'QuantitativeValue',
          minValue: service.moq,
          unitCode: 'C62', // pieces
        },
      },
    },
  })),
};
---

<BaseLayout
  title="Layanan Konveksi & Pembuatan Seragam B2B Garment | Wilcore"
  description="Layanan jasa konveksi seragam kerja profesional: Kemeja PDH/PDL, Kaos Polo Bordir, Kaos Event Sablon, Jaket Bomber, dan Wearpack Safety K3 berstandar garment."
  schema={serviceSchema}
>
  <!-- Page Header Banner -->
  <section class="bg-slate-900 text-white py-16 sm:py-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/20 text-orange-400 text-xs font-bold uppercase tracking-wider border border-orange-500/30">
        Spesifikasi Produksi Wilcore
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white">
        Layanan Konveksi &amp; Pembuatan Seragam Kustom Garment
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Solusi terpadu pengadaan pakaian korporat, komunitas, dan instansi dengan standar mutu jahit garment ekspor, bordir komputer Barudan, dan sablon reaktif bersertifikasi.
      </p>

      <!-- Quick Jump Anchors -->
      <div class="pt-6 flex flex-wrap justify-center gap-2">
        {
          services.map((item) => (
            <a
              href={`#${item.id}`}
              class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-orange-600 text-slate-300 hover:text-white transition-colors border border-slate-700"
            >
              {item.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Service List Detail Sections -->
  <section class="py-16 sm:py-24 bg-white space-y-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
      {
        services.map((service, index) => {
          const isEven = index % 2 === 1;
          const waUrl = `https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(
            service.whatsappMessage
          )}`;

          return (
            <article
              id={service.id}
              class="scroll-mt-28 p-8 sm:p-10 rounded-3xl bg-slate-50 border border-slate-200 shadow-sm"
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                
                <!-- Product Illustration / Image (col-span-5) -->
                <div class:list={['lg:col-span-5', isEven ? 'lg:order-last' : '']}>
                  <div class="rounded-2xl overflow-hidden border border-slate-300 bg-slate-900 shadow-md">
                    <img
                      src={service.image}
                      alt={`Katalog Spesifikasi ${service.name} Wilcore`}
                      width="600"
                      height="400"
                      loading="lazy"
                      class="w-full h-auto object-cover"
                    />
                  </div>

                  <!-- Quick Stats Under Image -->
                  <div class="mt-4 grid grid-cols-2 gap-3 text-center">
                    <div class="bg-white p-3 rounded-xl border border-slate-200">
                      <p class="text-[11px] text-slate-500 uppercase font-semibold">Minimal Order (MOQ)</p>
                      <p class="text-base font-extrabold text-orange-600 mt-0.5">{service.moq} pcs</p>
                    </div>
                    <div class="bg-white p-3 rounded-xl border border-slate-200">
                      <p class="text-[11px] text-slate-500 uppercase font-semibold">Estimasi Produksi</p>
                      <p class="text-base font-extrabold text-slate-900 mt-0.5">{service.leadTime}</p>
                    </div>
                  </div>
                </div>

                <!-- Product Specifications & Details (col-span-7) -->
                <div class="lg:col-span-7 space-y-6">
                  <div>
                    <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-orange-100 text-orange-800 mb-2">
                      {service.badge}
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
                      {service.name}
                    </h2>
                    <p class="mt-3 text-sm sm:text-base text-slate-700 leading-relaxed">
                      {service.fullDescription}
                    </p>
                  </div>

                  <!-- Material Choices -->
                  <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                      Pilihan Bahan Baku Rekomendasi:
                    </h3>
                    <div class="flex flex-wrap gap-2">
                      {service.recommendedMaterials.map((mat) => (
                        <span class="px-3 py-1 rounded-lg text-xs font-medium bg-white text-slate-800 border border-slate-200 shadow-2xs">
                          {mat}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- Key Technical Features -->
                  <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                      Spesifikasi Teknis &amp; Jahitan:
                    </h3>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700">
                      {service.features.map((feat) => (
                        <li class="flex items-center gap-2">
                          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                          </svg>
                          <span>{feat}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Finishing Options & Popular Use Cases -->
                  <div class="p-4 rounded-xl bg-white border border-slate-200 space-y-2 text-xs">
                    <p class="text-slate-500 font-semibold uppercase tracking-wider">
                      Opsi Finishing / Aplikasi:
                    </p>
                    <p class="text-slate-800 font-medium">
                      {service.finishingOptions.join(' • ')}
                    </p>
                    <div class="pt-2 border-t border-slate-100 flex flex-wrap items-center gap-1 text-[11px] text-slate-500">
                      <span class="font-semibold text-slate-700">Cocok Untuk:</span>
                      {service.popularFor.map((item, i) => (
                        <span>{item}{i < service.popularFor.length - 1 ? ',' : ''}</span>
                      ))}
                    </div>
                  </div>

                  <!-- WhatsApp Action Button for this service -->
                  <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                    <a
                      href={waUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-sm font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-950/20 transition-all transform hover:-translate-y-0.5"
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"/>
                      </svg>
                      <span>Konsultasi &amp; Penawaran {service.name}</span>
                    </a>

                    <a
                      href="/panduan-bahan"
                      class="inline-flex items-center justify-center px-4 py-3 rounded-xl text-xs font-bold text-slate-700 hover:text-orange-600 bg-white border border-slate-300 hover:border-orange-500 transition-colors"
                    >
                      Cek Karakteristik Bahan
                    </a>
                  </div>

                </div>

              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- CTA Banner Bottom -->
  <section class="py-16 bg-slate-900 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold">Memiliki Desain Seragam Kustom di Luar Katalog di Atas?</h2>
      <p class="text-sm text-slate-300 max-w-xl mx-auto">
        Kirimkan sketsa desain, file PDF/AI/Corel, atau foto contoh seragam yang Anda inginkan ke tim teknis Wilcore untuk dianalisis pola &amp; biayanya.
      </p>
      <div class="pt-4">
        <a
          href="/kontak"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-xl text-sm font-bold bg-orange-600 hover:bg-orange-500 text-white shadow-xl transition-all"
        >
          <span>Kirim Sketsa / Request Quotation</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
