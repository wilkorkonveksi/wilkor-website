---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articlesData from '../../data/articles.json';

export interface ArticleItem {
  title: string;
  slug: string;
  category: string;
  date: string;
  readTime: string;
  summary: string;
}

const articles: ArticleItem[] = articlesData as ArticleItem[];
---

<BaseLayout
  title="Blog & Edukasi Industri Konveksi Garment | Wilcore"
  description="Kumpulan artikel edukatif, panduan memilih bahan kain seragam, tips sablon dan bordir komputer, serta standar keselamatan pakaian kerja K3."
>
  <!-- Header Banner -->
  <section class="bg-slate-900 text-white py-16 sm:py-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/20 text-orange-400 text-xs font-bold uppercase tracking-wider border border-orange-500/30">
        Wawasan Tekstil &amp; Manufaktur
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white">
        Blog &amp; Edukasi Industri Konveksi Garment
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Referensi komprehensif bagi praktisi procurement, HRD, dan panitia pengadaan untuk membuat keputusan tepat dalam pemesanan pakaian seragam.
      </p>
    </div>
  </section>

  <!-- Blog List -->
  <section class="py-16 sm:py-24 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      {
        articles.map((post) => (
          <article class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow duration-200 space-y-4">
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
              <span class="px-2.5 py-1 rounded-md bg-orange-50 text-orange-700 font-bold uppercase tracking-wider">
                {post.category}
              </span>
              <span>•</span>
              <time>{post.date}</time>
              <span>•</span>
              <span>{post.readTime}</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 hover:text-orange-600 transition-colors">
              <a href="/kontak" class="focus:outline-none">
                {post.title}
              </a>
            </h2>

            <p class="text-slate-600 text-sm leading-relaxed">
              {post.summary}
            </p>

            <div class="pt-2 flex items-center justify-between text-xs">
              <a
                href="/kontak"
                class="font-bold text-orange-600 hover:text-orange-700 inline-flex items-center gap-1"
              >
                <span>Konsultasikan Topik Ini ke Sales Kami</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <span class="text-slate-400">Pabrik Garment Wilcore</span>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
