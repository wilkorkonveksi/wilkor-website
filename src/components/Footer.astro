---
import { siteConfig } from '../data/siteConfig';
import { services } from '../data/services';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-slate-800 text-sm">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Column 1: Company Profile & Trust Badges (span 2 on lg) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-orange-600 flex items-center justify-center font-black text-xl text-white">
            W
          </div>
          <span class="text-2xl font-black tracking-tight text-white">
            WILCORE<span class="text-orange-500">.</span>
          </span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed pr-4">
          {siteConfig.legalName} adalah mitra manufaktur pakaian dan vendor seragam B2B terkemuka. Kami memadukan teknologi mesin mutakhir, tenaga jahit terampil, dan kontrol kualitas 3-tahap untuk menghasilkan seragam berdaya tahan tinggi.
        </p>

        <!-- B2B Invoicing & Tax Status Badge -->
        <div class="pt-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Legalitas Resmi: Perusahaan Kena Pajak (PKP) • Faktur Pajak &amp; SPK Siap</span>
          </div>
        </div>

        <!-- Social Icons -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href={siteConfig.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram Wilcore"
            class="w-9 h-9 rounded-lg bg-slate-900 hover:bg-orange-600 hover:text-white flex items-center justify-center transition-colors text-slate-400 border border-slate-800"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn Wilcore"
            class="w-9 h-9 rounded-lg bg-slate-900 hover:bg-orange-600 hover:text-white flex items-center justify-center transition-colors text-slate-400 border border-slate-800"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Layanan Konveksi -->
      <div class="space-y-3">
        <p class="text-xs font-bold tracking-wider text-slate-200 uppercase">
          Layanan Produksi
        </p>
        <ul class="space-y-2 text-sm">
          {
            services.map((item) => (
              <li>
                <a href={`/layanan#${item.id}`} class="hover:text-orange-400 transition-colors">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Panduan & Informasi -->
      <div class="space-y-3">
        <p class="text-xs font-bold tracking-wider text-slate-200 uppercase">
          Panduan &amp; Referensi
        </p>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/panduan-bahan" class="hover:text-orange-400 transition-colors">
              Katalog Karakteristik Kain
            </a>
          </li>
          <li>
            <a href="/panduan-bahan#size-chart" class="hover:text-orange-400 transition-colors">
              Standar Size Chart S - 3XL
            </a>
          </li>
          <li>
            <a href="/portofolio" class="hover:text-orange-400 transition-colors">
              Galeri Proyek Selesai
            </a>
          </li>
          <li>
            <a href="/tentang-kami" class="hover:text-orange-400 transition-colors">
              Kapasitas &amp; Workshop Pabrik
            </a>
          </li>
          <li>
            <a href="/blog" class="hover:text-orange-400 transition-colors">
              Artikel &amp; Edukasi Garment
            </a>
          </li>
          <li>
            <a href="/kontak" class="hover:text-orange-400 transition-colors">
              Simulasi &amp; Request Penawaran
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Kontak & Workshop -->
      <div class="space-y-3">
        <p class="text-xs font-bold tracking-wider text-slate-200 uppercase">
          Workshop &amp; Kontak
        </p>
        <div class="space-y-2.5 text-xs text-slate-400">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 text-orange-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{siteConfig.address.street}, {siteConfig.address.city}, {siteConfig.address.province}</span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`https://wa.me/${siteConfig.whatsapp.number}`} class="hover:text-emerald-400 transition-colors">
              {siteConfig.whatsapp.display} (Fast Response)
            </a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-sky-400 transition-colors">
              {siteConfig.email}
            </a>
          </p>
          <p class="text-[11px] text-slate-500 pt-2 border-t border-slate-900">
            {siteConfig.businessHours.workdays}<br />
            {siteConfig.businessHours.weekend}
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Disclaimer -->
    <div class="mt-12 pt-8 border-t border-slate-900 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-500">
      <p>
        &copy; {currentYear} {siteConfig.legalName}. Seluruh Hak Cipta Dilindungi Undang-Undang.
      </p>
      <div class="flex items-center gap-6">
        <span>Pengiriman ke Seluruh Nusantara (Sabang - Merauke)</span>
        <span class="text-slate-800">|</span>
        <span>Standar SNI &amp; Garment Industri</span>
      </div>
    </div>
  </div>
</footer>
