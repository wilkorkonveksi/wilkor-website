---
import { siteConfig } from '../data/siteConfig';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/layanan', label: 'Layanan' },
  { href: '/panduan-bahan', label: 'Panduan Bahan' },
  { href: '/portofolio', label: 'Portofolio' },
  { href: '/tentang-kami', label: 'Tentang Kami' },
  { href: '/kontak', label: 'Kontak' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-40 w-full bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white transition-all">
  <!-- Top announcement bar for B2B credibility -->
  <div class="bg-slate-950 py-1.5 px-4 text-xs text-slate-400 border-b border-slate-800/80">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-1.5">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Kapasitas Pabrik Aktif: 150.000 Pcs/Bulan
        </span>
        <span class="hidden md:inline text-slate-600">•</span>
        <span class="hidden md:inline">Garansi Mutu Standar Garment Ekspor</span>
      </div>
      <div class="flex items-center gap-4 text-slate-300">
        <a href={`https://wa.me/${siteConfig.whatsapp.number}`} class="hover:text-emerald-400 transition-colors flex items-center gap-1">
          <span class="text-emerald-400 font-bold">WA:</span> {siteConfig.whatsapp.display}
        </a>
        <span class="text-slate-700">|</span>
        <span>{siteConfig.businessHours.workdays}</span>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="Wilcore Beranda">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange-500 to-orange-700 flex items-center justify-center font-black text-xl text-white shadow-md shadow-orange-900/30 group-hover:scale-105 transition-transform">
          W
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-black tracking-tight text-white flex items-center">
            WILCORE<span class="text-orange-500">.</span>
          </span>
          <span class="text-[10px] tracking-widest text-slate-400 font-semibold uppercase -mt-1">
            Garment &amp; Konveksi
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Menu Utama">
        {
          navLinks.map((link) => {
            const active = isActive(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'px-3.5 py-2 rounded-lg text-sm font-medium transition-colors duration-150',
                  active
                    ? 'text-orange-400 bg-slate-800/80 font-semibold'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/40',
                ]}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Desktop Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/kontak"
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-orange-600 hover:bg-orange-500 active:bg-orange-700 text-white shadow-lg shadow-orange-900/30 transition-all duration-150 hover:-translate-y-0.5"
        >
          Minta Penawaran
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="Buka Menu Navigasi"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-orange-500"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu (Vanilla JS Controlled) -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-slate-900 border-b border-slate-800 px-4 pt-2 pb-6 space-y-1 transition-all"
  >
    {
      navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              'block px-3 py-2.5 rounded-md text-base font-medium transition-colors',
              active
                ? 'bg-slate-800 text-orange-400 font-semibold'
                : 'text-slate-300 hover:text-white hover:bg-slate-800/60',
            ]}
          >
            {link.label}
          </a>
        );
      })
    }
    <div class="pt-4 border-t border-slate-800 flex flex-col gap-2.5">
      <a
        href="/kontak"
        class="w-full text-center px-4 py-3 rounded-lg text-sm font-bold uppercase tracking-wider bg-orange-600 hover:bg-orange-500 text-white shadow-md"
      >
        Minta Penawaran Cepat
      </a>
      <a
        href={`https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(siteConfig.whatsapp.defaultMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center px-4 py-2.5 rounded-lg text-sm font-bold bg-emerald-600 hover:bg-emerald-500 text-white flex items-center justify-center gap-2"
      >
        <span>Chat WhatsApp Admin</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Ultra-lightweight Vanilla JS Toggle (Zero Bloatware)
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (btn && menu && iconOpen && iconClose) {
      btn.addEventListener('click', function () {
        const isOpen = !menu.classList.contains('hidden');
        if (isOpen) {
          menu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          menu.classList.remove('hidden');
          iconOpen.classList.add('hidden');
          iconClose.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
  })();
</script>
