---
import { partnerRow1, partnerRow2 } from '../data/partners';

// Duplicate rows for infinite seamless marquee loop
const row1Items = [...partnerRow1, ...partnerRow1, ...partnerRow1];
const row2Items = [...partnerRow2, ...partnerRow2, ...partnerRow2];
---

<section class="py-16 sm:py-20 bg-slate-900 border-b border-slate-800 overflow-hidden relative" aria-label="Our Partners">
  <!-- Subtle Industrial Glow Backdrop -->
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="absolute top-1/2 left-1/4 w-96 h-96 -translate-y-1/2 rounded-full bg-orange-600 blur-3xl"></div>
    <div class="absolute top-1/2 right-1/4 w-96 h-96 -translate-y-1/2 rounded-full bg-sky-600 blur-3xl"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-12">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-bold uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
        <span>Trusted B2B Collaborations</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Our Partners &amp; Klien Terpercaya
      </h2>
      <p class="text-sm sm:text-base text-slate-400">
        Dipercaya oleh lebih dari 650+ korporasi multinasional, BUMN terkemuka, kementerian pemerintah, dan universitas di seluruh Indonesia.
      </p>
    </div>

  </div>

  <!-- Marquee Scroller Wrapper with Edge Gradients for Smooth Visual Fade -->
  <div class="relative w-full space-y-5 overflow-hidden">
    
    <!-- Left Fade Gradient -->
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-20 sm:w-36 bg-gradient-to-r from-slate-900 via-slate-900/90 to-transparent z-20"></div>
    
    <!-- Right Fade Gradient -->
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-20 sm:w-36 bg-gradient-to-l from-slate-900 via-slate-900/90 to-transparent z-20"></div>

    <!-- Row 1: Moves Left -->
    <div class="flex overflow-hidden group select-none">
      <div class="flex shrink-0 items-center gap-5 animate-marquee-left group-hover:[animation-play-state:paused] will-change-transform py-1">
        {
          row1Items.map((partner) => (
            <div
              class="shrink-0 h-16 sm:h-20 px-6 sm:px-8 bg-slate-800/80 hover:bg-slate-800 rounded-2xl border border-slate-700/60 hover:border-orange-500/60 shadow-md hover:shadow-lg transition-all duration-300 flex items-center justify-center group/card cursor-pointer"
              title={`${partner.title} - ${partner.sector}`}
            >
              <img
                src={partner.logo}
                alt={`Logo ${partner.title} - Partner Wilcore`}
                width="160"
                height="40"
                loading="lazy"
                class="h-8 sm:h-10 w-auto max-w-[140px] sm:max-w-[170px] object-contain brightness-0 invert opacity-75 group-hover/card:opacity-100 transition duration-300 transform group-hover/card:scale-105"
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Row 2: Moves Right (Opposite Direction) -->
    <div class="flex overflow-hidden group select-none">
      <div class="flex shrink-0 items-center gap-5 animate-marquee-right group-hover:[animation-play-state:paused] will-change-transform py-1">
        {
          row2Items.map((partner) => (
            <div
              class="shrink-0 h-16 sm:h-20 px-6 sm:px-8 bg-slate-800/80 hover:bg-slate-800 rounded-2xl border border-slate-700/60 hover:border-orange-500/60 shadow-md hover:shadow-lg transition-all duration-300 flex items-center justify-center group/card cursor-pointer"
              title={`${partner.title} - ${partner.sector}`}
            >
              <img
                src={partner.logo}
                alt={`Logo ${partner.title} - Partner Wilcore`}
                width="160"
                height="40"
                loading="lazy"
                class="h-8 sm:h-10 w-auto max-w-[140px] sm:max-w-[170px] object-contain brightness-0 invert opacity-75 group-hover/card:opacity-100 transition duration-300 transform group-hover/card:scale-105"
              />
            </div>
          ))
        }
      </div>
    </div>

  </div>

  <!-- Bottom CTA: "VIEW ALL" Button -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-10 relative z-10">
    <a
      href="/portofolio"
      class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl text-xs sm:text-sm font-extrabold uppercase tracking-wider bg-orange-600 hover:bg-orange-500 active:bg-orange-700 text-white shadow-lg shadow-orange-950/40 hover:shadow-orange-600/30 transition-all duration-200 transform hover:-translate-y-0.5"
    >
      <span>VIEW ALL</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</section>
