---
import type { ServiceItem } from '../data/services';
import { siteConfig } from '../data/siteConfig';

export interface Props {
  service: ServiceItem;
  featured?: boolean;
}

const { service, featured = false } = Astro.props;

const waProductUrl = `https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(
  service.whatsappMessage
)}`;
---

<article class="flex flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 group">
  <!-- Card Header Graphic/Image -->
  <div class="relative w-full aspect-[16/10] bg-slate-900 overflow-hidden">
    <img
      src={service.image}
      alt={`Produksi ${service.name} - Wilcore Garment Konveksi`}
      width="600"
      height="400"
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <!-- Floating Badge -->
    <div class="absolute top-3 left-3">
      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold bg-orange-600 text-white shadow-md">
        {service.badge}
      </span>
    </div>
    <!-- MOQ & Lead Time Badge -->
    <div class="absolute bottom-3 right-3 flex items-center gap-1.5">
      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[10px] font-bold bg-slate-900/90 text-white backdrop-blur-sm border border-slate-700">
        MOQ: {service.moq} pcs
      </span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="flex flex-col flex-grow p-6">
    <h3 class="text-xl font-bold text-slate-900 group-hover:text-orange-600 transition-colors">
      <a href={`/layanan#${service.id}`}>
        {service.name}
      </a>
    </h3>

    <p class="mt-2 text-sm text-slate-600 line-clamp-3 leading-relaxed">
      {service.shortDescription}
    </p>

    <!-- Key Material Highlights -->
    <div class="mt-4 pt-4 border-t border-slate-100 space-y-2">
      <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Bahan Rekomendasi:
      </p>
      <div class="flex flex-wrap gap-1.5">
        {
          service.recommendedMaterials.slice(0, 3).map((mat) => (
            <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-700">
              {mat}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Actions / CTAs at bottom -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
      <a
        href={`/layanan#${service.id}`}
        class="text-xs font-bold text-slate-700 hover:text-orange-600 inline-flex items-center gap-1 group/link"
      >
        <span>Lihat Spek Lengkap</span>
        <svg class="w-3.5 h-3.5 transform group-hover/link:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href={waProductUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm transition-all"
        aria-label={`Pesan ${service.name} via WhatsApp`}
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"/>
        </svg>
        <span>Pesan WA</span>
      </a>
    </div>
  </div>
</article>
