---
export interface FAQItem {
  question: string;
  answer: string;
}

export const faqs: FAQItem[] = [
  {
    question: "Berapa batas minimal pemesanan (Minimum Order Quantity / MOQ) di Wilcore?",
    answer:
      "Untuk sebagian besar produk seragam kerja (Kemeja PDH/PDL, Kaos Polo Bordir, Jaket, dan Wearpack), minimal pemesanan adalah 24 pcs per desain. Khusus untuk Kaos Oblong Sablon dan Jas Almamater, minimal order adalah 36 pcs. Pemesanan skala besar (di atas 500 – 10.000+ pcs) akan mendapatkan penawaran harga pabrik (wholesale) bertingkat yang jauh lebih hemat.",
  },
  {
    question: "Berapa lama estimasi waktu produksi pesanan seragam hingga selesai?",
    answer:
      "Standar waktu produksi adalah 7 hingga 14 hari kerja tergantung jenis pakaian, kompleksitas bordir/sablon, dan volume pesanan. Untuk kebutuhan mendesak (Urgent / Express Project), kami menyediakan layanan jalur produksi prioritas dengan SLA khusus setelah disepakati bersama tim produksi.",
  },
  {
    question: "Apakah klien dapat meminta pembuatan sampel fisik (sample proofing) sebelum produksi massal?",
    answer:
      "Ya, tentu saja. Untuk order skala B2B/perusahaan, kami memfasilitasi pembuatan sampel fisik (approval sample) setelah kesepakatan penawaran kerja sama dan DP tahap awal disetujui. Selain itu, kami juga menyediakan katalog sampel bahan fisik (fabric swatches) dan mockup visual 3D gratis untuk asistensi presentasi internal Anda.",
  },
  {
    question: "Bagaimana jaminan garansi produk jika terdapat cacat jahit atau ketidaksesuaian ukuran?",
    answer:
      "Wilcore memberikan Garansi Retur & Perbaikan 100%. Apabila ditemukan cacat produksi seperti jahitan lepas, sablon rontok, bordir cacat, atau ukuran di luar toleransi jahit yang disepakati, tim kami akan memperbaikinya atau mengganti unit baru tanpa biaya tambahan dalam waktu 7 hari sejak barang diterima.",
  },
  {
    question: "Apakah Wilcore mendukung legalitas resmi Faktur Pajak dan SPK untuk pengadaan B2B / BUMN?",
    answer:
      "Tentu. Wilcore beroperasi di bawah badan hukum PT resmi berstatus Pengusaha Kena Pajak (PKP). Kami siap menerbitkan Surat Perintah Kerja (SPK), Faktur Pajak resmi (e-Faktur), kuitansi bermaterai, dan invoice resmi untuk keperluan pembukuan atau audit instansi Anda.",
  },
  {
    question: "Apakah Wilcore dapat mengirimkan pesanan ke luar kota dan seluruh wilayah Indonesia?",
    answer:
      "Bisa. Kami bekerja sama dengan mitra ekspedisi kargo darat, laut, dan udara terpercaya (Indah Cargo, JNE Trucking, KALOG, Baraka, Dakota, hingga Garuda Cargo) dengan tarif kargo B2B yang kompetitif dan jaminan asuransi pengiriman ke seluruh kota dari Sabang sampai Merauke.",
  },
];
---

<section id="faq" class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-100 text-orange-800 text-xs font-bold uppercase tracking-wider">
        Pusat Bantuan &amp; Edukasi
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Pertanyaan Umum Seputar Pemesanan (FAQ)
      </h2>
      <p class="text-base text-slate-600 max-w-2xl mx-auto">
        Kumpulan jawaban transparan seputar proses manufaktur pakaian, ketentuan MOQ, garansi mutu, dan skema pengadaan di Wilcore.
      </p>
    </div>

    <!-- Accordion List using Native Lightweight HTML5 details/summary -->
    <div class="mt-12 space-y-4">
      {
        faqs.map((faq, index) => (
          <details class="group bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:border-slate-300 transition-colors [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-slate-900 text-base sm:text-lg group-open:text-orange-600 transition-colors">
              <span class="pr-4">{faq.question}</span>
              <span class="shrink-0 w-8 h-8 rounded-full bg-slate-100 group-hover:bg-orange-50 group-open:bg-orange-600 group-open:text-white flex items-center justify-center transition-all text-slate-600">
                <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 pt-3 border-t border-slate-100 text-slate-600 text-sm leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>

    <!-- Still Have Questions CTA -->
    <div class="mt-12 p-6 rounded-2xl bg-slate-900 text-white text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6 shadow-lg">
      <div>
        <h3 class="text-lg font-bold">Punya Pertanyaan Spesifik Terkait Tender / Pesanan Anda?</h3>
        <p class="text-xs text-slate-300 mt-1">Konsultasikan langsung dengan Customer Relationship Manager Wilcore via WhatsApp.</p>
      </div>
      <a
        href="https://wa.me/6281234567890?text=Halo%20Wilcore%2C%20saya%20ingin%20konsultasi%20pertanyaan%20spesifik%20seputar%20pemesanan%20seragam."
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 font-bold text-xs uppercase tracking-wider text-white shadow-md transition-all flex items-center gap-2"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"/>
        </svg>
        <span>Tanya Tim Wilcore</span>
      </a>
    </div>

  </div>
</section>
