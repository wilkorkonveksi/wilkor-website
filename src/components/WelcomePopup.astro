---
import { promoConfig } from '../data/promo';
import { siteConfig } from '../data/siteConfig';

const waPromoUrl = `https://wa.me/${siteConfig.whatsapp.number}?text=${encodeURIComponent(
  promoConfig.whatsappMessage
)}`;
---

{promoConfig.active && (
  <div
    id="welcome-promo-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="promo-title"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-300 ease-out"
  >
    <!-- Dark Backdrop Overlay -->
    <div
      id="promo-backdrop"
      class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm transition-opacity"
      aria-hidden="true"
    ></div>

    <!-- Modal Dialog Card -->
    <div
      id="promo-dialog"
      class="relative w-full max-w-lg bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden transform scale-95 transition-all duration-300 z-10"
    >
      <!-- Top Decorative Accent Header -->
      <div class="relative bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 text-white p-6 sm:p-7 border-b border-slate-800">
        <!-- Close Button (X) -->
        <button
          type="button"
          id="promo-close-btn"
          aria-label="Tutup Promo"
          class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-800/80 hover:bg-orange-600 text-slate-300 hover:text-white flex items-center justify-center transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-orange-500 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/20 text-orange-400 text-[11px] font-bold uppercase tracking-wider border border-orange-500/30">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
          <span>{promoConfig.badge}</span>
        </span>

        <h3 id="promo-title" class="text-xl sm:text-2xl font-extrabold text-white mt-3 leading-snug">
          {promoConfig.title}
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 leading-relaxed">
          {promoConfig.description}
        </p>
      </div>

      <!-- Modal Body: Perks List & CTAs -->
      <div class="p-6 sm:p-7 space-y-6 bg-slate-50">
        <!-- Perks Checklist -->
        <ul class="space-y-2.5">
          {promoConfig.perks.map((perk) => (
            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 font-medium">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
              </span>
              <span>{perk}</span>
            </li>
          ))}
        </ul>

        <!-- Action Buttons -->
        <div class="space-y-3 pt-2">
          <!-- WhatsApp CTA Button -->
          <a
            id="promo-wa-cta"
            href={waPromoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-xl text-sm font-bold bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white shadow-xl shadow-emerald-950/20 hover:shadow-emerald-600/30 transition-all duration-200 transform hover:-translate-y-0.5 text-center"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2Z"/>
            </svg>
            <span>{promoConfig.ctaText}</span>
          </a>

          <!-- Secondary Dismiss / Portfolio Link -->
          <div class="flex items-center justify-between text-xs pt-1 px-1 text-slate-500">
            <button
              type="button"
              id="promo-dismiss-btn"
              class="hover:text-slate-800 transition-colors cursor-pointer underline underline-offset-2"
            >
              Nanti Saja
            </button>
            <a
              href="/portofolio"
              id="promo-portfolio-link"
              class="font-bold text-orange-600 hover:text-orange-700 transition-colors"
            >
              {promoConfig.secondaryText} &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
)}

<script is:inline>
  // Pure Vanilla JS Welcome Popup with LocalStorage & 2-Second Delay
  (function () {
    const STORAGE_KEY = 'wilcore_welcome_promo_v1';
    const modal = document.getElementById('welcome-promo-modal');
    const dialog = document.getElementById('promo-dialog');
    const backdrop = document.getElementById('promo-backdrop');
    const closeBtn = document.getElementById('promo-close-btn');
    const dismissBtn = document.getElementById('promo-dismiss-btn');
    const portfolioLink = document.getElementById('promo-portfolio-link');
    const waCta = document.getElementById('promo-wa-cta');

    if (!modal) return;

    // Check if visitor has already seen the popup in this browser
    const hasSeen = localStorage.getItem(STORAGE_KEY);

    // Only auto-open if never seen before, and specifically on initial landing
    if (!hasSeen) {
      setTimeout(() => {
        openModal();
      }, 2000);
    }

    function openModal() {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      if (dialog) {
        dialog.classList.remove('scale-95');
        dialog.classList.add('scale-100');
      }
      document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      if (dialog) {
        dialog.classList.remove('scale-100');
        dialog.classList.add('scale-95');
      }
      document.body.classList.remove('overflow-hidden');
      // Remember that user has closed or interacted with popup
      try {
        localStorage.setItem(STORAGE_KEY, 'seen');
      } catch (e) {}
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (dismissBtn) dismissBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (portfolioLink) portfolioLink.addEventListener('click', closeModal);
    if (waCta) waCta.addEventListener('click', closeModal);

    // Close on Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('opacity-100')) {
        closeModal();
      }
    });
  })();
</script>
