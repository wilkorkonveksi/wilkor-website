---
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWA from '../components/FloatingWA.astro';
import WelcomePopup from '../components/WelcomePopup.astro';

export interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string | URL;
  ogImage?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  type?: 'website' | 'article';
  floatingWAMessage?: string;
}

const {
  title,
  description,
  canonicalURL,
  ogImage,
  schema,
  type,
  floatingWAMessage,
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogImage={ogImage}
      schema={schema}
      type={type}
    />
  </head>
  <body class="bg-white text-slate-900 font-sans antialiased selection:bg-orange-500 selection:text-white min-h-screen flex flex-col">
    <!-- Header / Navbar -->
    <Navbar />

    <!-- Main Page Content -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Global Floating WhatsApp Trigger -->
    <FloatingWA message={floatingWAMessage} />

    <!-- Global Welcome Promo & WhatsApp Popup -->
    <WelcomePopup />
  </body>
</html>
